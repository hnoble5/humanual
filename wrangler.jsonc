{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "humanual",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // The UI in ./public is served as static files. Only /api/* runs the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The Worker sees every request so it can redirect the old addresses
    // (src/worker.ts, MOVED_HOSTS); it hands everything else to the static files.
    "run_worker_first": true
  },
  // Profiles, conversations, and saved scripts for signed-in users (see migrations/).
  "d1_databases": [
    { "binding": "DB", "database_name": "humanual", "database_id": "260d2093-1021-4141-a36c-a09faa2df190", "migrations_dir": "migrations" }
  ],
  // Lets src/prompt.ts import the Markdown prompt files as plain text.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "observability": { "enabled": true },
  // One Worker, several addresses (README, "Addresses"):
  //  - humanual.app: the real app, private behind Cloudflare Access until launch.
  //  - demo.humanual.app: public demo at /demo. The coach and sync refuse to
  //    run there, so nobody can spend API credit from it.
  //  - www.humanual.app and the old elitetestautomation.com addresses only
  //    redirect to the two above.
  "routes": [
    { "pattern": "humanual.app", "custom_domain": true },
    { "pattern": "www.humanual.app", "custom_domain": true },
    { "pattern": "demo.humanual.app", "custom_domain": true },
    { "pattern": "humanual.elitetestautomation.com", "custom_domain": true },
    { "pattern": "coach.elitetestautomation.com", "custom_domain": true }
  ],
  // Otherwise `wrangler dev` presents requests as coming from the route's host,
  // which turns off the localhost-only dev sign-in (src/auth.ts).
  "dev": { "host": "localhost" },
  // Off: a *.workers.dev address would skip Cloudflare Access on humanual.
  "workers_dev": false,
  // Hosts that serve the full app; everything else gets only the demo (src/worker.ts).
  // USER_MONTHLY_LIMIT_USD: each signed-in user's monthly AI allowance (src/usage.ts).
  // The guest trial (src/guest.ts): GUEST_MESSAGE_LIMIT free coach messages per
  // guest ("0" turns it off), at most GUEST_IP_DAILY_MESSAGES per network per
  // day, and GUEST_DAILY_LIMIT_USD of AI cost per day across all guests.
  "vars": {
    "APP_HOSTS": "humanual.app",
    "USER_MONTHLY_LIMIT_USD": "1",
    "GUEST_MESSAGE_LIMIT": "5",
    "GUEST_IP_DAILY_MESSAGES": "15",
    "GUEST_DAILY_LIMIT_USD": "2"
  },
  "preview_urls": false
}
