{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "humanual",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // The UI in ./public is served as static files. Only /api/* runs the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Profiles, conversations, and saved scripts for signed-in users (see migrations/).
  "d1_databases": [
    { "binding": "DB", "database_name": "humanual", "database_id": "260d2093-1021-4141-a36c-a09faa2df190", "migrations_dir": "migrations" }
  ],
  // Lets src/prompt.ts import the Markdown prompt files as plain text.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "observability": { "enabled": true },
  // Two addresses, one Worker:
  //  - coach.: public, for the portfolio demo at /demo. The coach and sync
  //    refuse to run there, so nobody can spend API credit from it.
  //  - humanual.: the real app, private behind Cloudflare Access (README, "Private app").
  "routes": [
    { "pattern": "coach.elitetestautomation.com", "custom_domain": true },
    { "pattern": "humanual.elitetestautomation.com", "custom_domain": true }
  ],
  // Otherwise `wrangler dev` presents requests as coming from the route's host,
  // which turns off the localhost-only dev sign-in (src/auth.ts).
  "dev": { "host": "localhost" },
  // Off: a *.workers.dev address would skip Cloudflare Access on humanual.
  "workers_dev": false,
  // Hosts that serve the full app; everything else gets only the demo (src/worker.ts).
  // Monthly AI allowance per signed-in user, in dollars of estimated API cost (src/usage.ts):
  //  - USER_MONTHLY_LIMIT_USD: free accounts (everyone, while payments are off).
  //  - PAID_MONTHLY_LIMIT_USD: founding members. Keep it well under the plan's
  //    price ($6/month) so each member still pays for more than their AI use.
  // STRIPE_AUTOMATIC_TAX: "true" adds sales tax at checkout (README, "Sales tax").
  "vars": {
    "APP_HOSTS": "humanual.elitetestautomation.com",
    "USER_MONTHLY_LIMIT_USD": "0.5",
    "PAID_MONTHLY_LIMIT_USD": "3",
    "STRIPE_AUTOMATIC_TAX": "false"
  },
  "preview_urls": false
}
