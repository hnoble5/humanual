{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "humanual",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // The UI in ./public is served as static files. Only /api/* runs the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Profiles, conversations, and saved scripts for signed-in users (see migrations/).
  // database_id is filled in when the production database is created.
  "d1_databases": [
    { "binding": "DB", "database_name": "humanual", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  // Lets src/prompt.ts import the Markdown prompt files as plain text.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false
}
